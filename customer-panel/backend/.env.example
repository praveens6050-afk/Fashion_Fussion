# Customer storefront server-only Cloudflare Pages variables.
# Never commit real secret values.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# PayU Hosted Checkout (production).
# Keep PAYU_ENABLED=false until credentials and callback verification are ready.
PAYU_ENABLED=false
PAYU_MERCHANT_KEY=your_live_merchant_key
PAYU_SALT=your_live_salt
PAYU_ENV=production
PUBLIC_SITE_URL=https://fashionfussion.in

# Existing Razorpay configuration is retained until PayU cutover is completed.
RAZORPAY_KEY_ID=your_live_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=choose_a_long_random_webhook_secret
ALLOWED_ORIGIN=https://fashionfussion.in

# Zoho Mail API (India data center defaults).
# Generate the refresh token with ZohoMail.messages.CREATE scope.
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
ZOHO_ACCOUNT_ID=your_zoho_mail_account_id
ZOHO_FROM_EMAIL=payments@your-domain.example
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_MAIL_BASE=https://mail.zoho.in

# During controlled preview testing only, ALLOWED_ORIGIN may be a comma-separated list:
# ALLOWED_ORIGIN=https://fashionfussion.in,https://YOUR-CUSTOMER-PREVIEW.pages.dev
