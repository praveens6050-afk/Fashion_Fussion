<!-- admin-panel/crm-dashboard.html -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>Fashion_Fussion — CRM Dashboard</title>
  <link rel="stylesheet" href="desktop-admin-premium.css?v=2">
  <link rel="stylesheet" href="csp-admin.css?v=1">
</head>
<body>
  <header class="header">
    <div class="header-inner">
      <div>
        <div class="logo">Fashion_Fussion</div>
        <div class="admin-badge">CRM</div>
      </div>
      <div class="header-actions">
        <a href="admin.html">Admin Dashboard</a>
        <a href="admin-account.html">My account</a>
      </div>
    </div>
  </header>

  <main class="dashboard" id="crmDashboardRoot">
    <div class="container">
      <div class="page-title">
        <div>
          <h1>CRM Dashboard</h1>
          <p>Overview of leads, sales activity and account health</p>
        </div>
      </div>

      <section class="stats">
        <div class="stat"><div class="stat-label">REVENUE</div><div class="stat-value">₹4.8L</div></div>
        <div class="stat"><div class="stat-label">ACCOUNTS</div><div class="stat-value">128</div></div>
        <div class="stat"><div class="stat-label">LEADS</div><div class="stat-value">94</div></div>
        <div class="stat"><div class="stat-label">OPEN TICKETS</div><div class="stat-value">17</div></div>
      </section>

      <section class="card">
        <div class="card-header">
          <h2>Recent sales activity</h2>
        </div>
        <div class="card-body">
          <table>
            <thead>
              <tr><th>Customer</th><th>Stage</th><th>Value</th><th>Status</th></tr>
            </thead>
            <tbody>
              <tr><td>Northwind Retail</td><td>Negotiation</td><td>₹82,000</td><td>In progress</td></tr>
              <tr><td>Urban Loom</td><td>Proposal</td><td>₹61,500</td><td>Awaiting review</td></tr>
              <tr><td>Metroline Studio</td><td>Closed</td><td>₹1,40,000</td><td>Won</td></tr>
            </tbody>
          </table>
        </div>
      </section>
    </div>
  </main>

  <script src="crm-dashboard.js?v=1"></script>
</body>
</html>
