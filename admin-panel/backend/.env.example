# Admin portal Vercel variables. Never commit real secret values.
# Admin Supabase database access uses the signed-in Admin JWT + RLS/RPC authorization.
SUPABASE_URL=https://gmdevprqtvoshbbytsxf.supabase.co
ALLOWED_ORIGIN=https://admin.fashionfussion.in,https://fashion-fussion-admin.vercel.app

# Razorpay server credentials are required for prepaid readiness/refunds.
RAZORPAY_KEY_ID=your_live_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Shiprocket API user credentials and pickup configuration.
SHIPROCKET_EMAIL=your_shiprocket_api_user_email
SHIPROCKET_PASSWORD=your_shiprocket_api_user_password
SHIPROCKET_PICKUP_LOCATION=your_exact_shiprocket_pickup_location_name
SHIPROCKET_PICKUP_PINCODE=your_6_digit_pickup_pincode

# SUPABASE_SECRET_KEY / SUPABASE_SERVICE_ROLE_KEY are intentionally not required
# by the standalone Admin portal's normal runtime path.
