{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Link", "value": "<https://fashion-fussion-olive.vercel.app/>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Link", "value": "<https://fashion-fussion-olive.vercel.app/>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/contact.html",
      "headers": [
        { "key": "Link", "value": "<https://fashion-fussion-olive.vercel.app/contact.html>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/shipping-delivery.html",
      "headers": [
        { "key": "Link", "value": "<https://fashion-fussion-olive.vercel.app/shipping-delivery.html>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/returns-refunds.html",
      "headers": [
        { "key": "Link", "value": "<https://fashion-fussion-olive.vercel.app/returns-refunds.html>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/privacy.html",
      "headers": [
        { "key": "Link", "value": "<https://fashion-fussion-olive.vercel.app/privacy.html>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/security-policy.html",
      "headers": [
        { "key": "Link", "value": "<https://fashion-fussion-olive.vercel.app/security-policy.html>; rel=\"canonical\"" }
      ]
    },
    {
      "source": "/search.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/product.html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, follow" }
      ]
    },
    {
      "source": "/(admin|admin-account|account|cart|checkout|quote-checkout|login|signup|reset-password|wishlist|notifications|coupons|gift-cards|order-confirmation|order-details|order-status|order-tracking).html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" }
      ]
    }
  ]
}
